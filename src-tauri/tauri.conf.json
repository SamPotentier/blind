{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Base",
  "version": "0.1.0",
  "identifier": "app.base.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Base",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Lanceur d'apps, de jeux, de projets et de notes qui remplace le bureau",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["French", "English"], "installMode": "currentUser" }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
